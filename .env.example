# Copy to .env.local for local overrides. Never commit .env.local!

# Base URL of the backend API Gateway (Traefik). Leave empty to use same-origin /v1/* calls
# (dev: Vite proxy below; prod: Nginx served behind Traefik).
VITE_API_BASE_URL=

# Dev-only: where the Vite dev server proxies /v1/* (Traefik entrypoint `web` of soa-market-backend).
VITE_DEV_GATEWAY_TARGET=http://localhost

# Shows the demo helper toolbar (Mailpit / Consul / Mock panels). Never true in production.
VITE_DEMO_MODE=false

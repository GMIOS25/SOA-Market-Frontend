# Copy to .env.local for local overrides. Never commit .env.local!

# Base URL of the backend API Gateway (Traefik). Leave empty to use same-origin /v1/* calls
# (dev: Vite proxy below; prod: Nginx served behind Traefik).
VITE_API_BASE_URL=

# Dev-only: where the Vite dev server proxies /v1/* (Traefik entrypoint `web` of soa-market-backend).
VITE_DEV_GATEWAY_TARGET=http://localhost

# Enables the authenticated MockPayment / MockShipping panel and local Vite proxies.
# Enable the respective backend PAYMENT_DEMO_ENABLED / SHIPPING_DEMO_ENABLED flag.
# Enter backend demo tokens in the panel. Do not put tokens in VITE_* variables.
# When hosting a demo build separately, route /mock/pay and /mock/ship to the respective services.
VITE_DEMO_MODE=false
DEMO_PAYMENT_PROXY_TARGET=http://localhost:8085
DEMO_SHIPPING_PROXY_TARGET=http://localhost:8086

# Public media origin for product and shop images (MinIO buckets `public-products`, `public-shops`,
# `public-reviews` allow anonymous download). API `imageRef` values are object keys resolved against it.
# Dev defaults to http://localhost:9000/public-products; a production build shows placeholders unless set.
VITE_MEDIA_BASE_URL=http://localhost:9000/public-products
